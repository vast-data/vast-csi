$namespace MirroredIO


$const uint16_t MAX_SECTION_CONFIGS_PER_RPC = 40;
$const uint16_t MAX_SECTION_REBUILDS_PER_RPC = 100;
$const uint16_t MAX_DEVS_PER_SECTION = 3;
$const uint32_t MAX_SECTION_ID = 16384;
$const uint32_t MAX_DEVS = 2048;  // Used for section 0.

struct PhysicalAddress {
    @0 device_guid GUID;
    @1 base_offset uint64_t;
};

// A container for a single section config message
struct SectionConfig {
    @0 section_id uint32_t;
    @1 mappings PhysicalAddress[MAX_DEVS_PER_SECTION];
    @2 num_mappings uint16_t;
    @3 in_rebuild uint8_t;  // Boolean
};

struct ConfigParams {
    @0 section_configs SectionConfig[MAX_SECTION_CONFIGS_PER_RPC];
    @1 num_sections uint16_t;
};

struct SectionRebuildParams {
    @0 section_id uint32_t;
    @1 new_mapping PhysicalAddress;
};

struct StartRebuildsParams {
    @0 section_rebuilds SectionRebuildParams[MAX_SECTION_REBUILDS_PER_RPC];
    @1 num_section_rebuilds uint16_t;
};

struct EndRebuildsParams {
    @0 section_ids uint32_t[MAX_SECTION_REBUILDS_PER_RPC];
    @1 num_section_ids uint16_t;
};

struct RebuildCopyParams {
    @0 section_id uint32_t;
};

struct RemoveMapping {
    @0 device_guid GUID;
    @1 section_id uint32_t;
};

struct RemoveMappingsParams {
    @0 remove_mappings RemoveMapping[128];
    @1 num_remove_mappings uint16_t;
};

struct RemoveDeviceParams {
    @0 device_guid GUID;
};
