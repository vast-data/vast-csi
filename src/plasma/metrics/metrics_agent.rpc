class: MetricsAgent
include: tracker.hpp
api_version: 1
namespaces: ["P", "Metrics"]
methods:
- method: get_generations
  op_id: 1
  fiber_group: P
  arg: Tracker::GetGenerationsParams
  res: Tracker::GetGenerationsResult
- method: get_modified
  op_id: 2
  fiber_group: P
  arg: Tracker::GetModifiedParams
  res: Tracker::GetModifiedResult
