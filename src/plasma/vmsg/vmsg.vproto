$namespace P::VMsg

$typedef uint16_t EnvId

$const size_t MAX_ADDR_PER_ENV = 4;

// A container for a single env address
struct EnvAddress {
    @0 host char[128];
    @1 port uint16_t;
};

// A container for an env addresses
struct EnvAddresses {
    @0 addresses EnvAddress[MAX_ADDR_PER_ENV];
    @1 n_addr uint16_t;
};
