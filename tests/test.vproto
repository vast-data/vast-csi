$namespace NS
$typedef bool flag

enum Gender : uint8_t {
    MALE = 0,
    FEMALE
};

enum Profession {
    JANITOR,
    PILOT
};

struct Empty {

};

struct Phone {
    @0 number uint32_t;
    @1 active bool = true;
};

struct Address {
    @0 street char[128];
    @1 number uint16_t = 999;
};

struct Person {
    @0 age uint32_t;
    @1 gender Gender;
    @3 weight uint32_t; // for testing: this field doesn't have a default value even though it should (it doesn't appear in the older version)
    @4 name char[123];
    @5 active flag = true;
    @7 profession Profession = Profession::PILOT;

    @2 phones Phone[2];
    @6 address Address;
};

