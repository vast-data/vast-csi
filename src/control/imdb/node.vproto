$import object.vproto
$import plasma/vmsg/vmsg.vproto as VMsg

$namespace Control

$const size_t NODE_ADDRESS_COUNT = 2;

enum NodeState : byte {
    INIT,
    ACTIVE,
    INACTIVE,
    FAILED
};

struct NodeAddress {
    @0 host char[VMsg.HOST_LENGTH];
};

struct BaseNodeProto {    
    @0 addresses NodeAddress[NODE_ADDRESS_COUNT];
    @1 version uint32_t;
    @2 enabled bool;
    @3 state NodeState;
};
