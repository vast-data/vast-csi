class: Cluster
include: ["cluster.vproto.hpp"]
api_version: 1
namespaces: ["Control"]
default_fiber_group: C
methods:
- method: system_status
  op_id: 0
  arg: SystemStatusParams
  res: SystemStatusResult
- method: system_activate
  op_id: 1
  arg: SystemActivateParams
  res: SystemActivateResult
- method: cnode_add
  op_id: 2
  arg: CNodeAddParams
  res: CNodeAddResult
- method: cnode_modify
  op_id: 3
  arg: CNodeModifyParams
  res: CNodeModifyResult
- method: cnode_remove
  op_id: 4
  arg: CNodeRemoveParams
  res: CNodeRemoveResult
- method: cnode_get
  op_id: 5
  arg: CNodeGetParams
  res: CNodeGetResult
- method: dbox_add
  op_id: 6
  arg: DBoxAddParams
  res: DBoxAddResult
- method: dbox_get
  op_id: 7
  arg: DBoxGetParams
  res: DBoxGetResult
- method: dnode_modify
  op_id: 8
  arg: DNodeModifyParams
  res: DNodeModifyResult

