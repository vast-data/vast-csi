$import object.vproto

$namespace Control

enum SystemState : byte {
    INIT,
    ONLINE,
    OFFLINE
};

struct SystemProto {
    @0 base_proto BaseObjectProto;

    @1 next_cnode_id uint16_t;
    @2 next_env_id uint16_t;
    @3 next_dbox_id uint16_t;
    @4 next_dnode_id uint16_t;

    @5 state SystemState;
    @6 shard_count uint32_t;
};
