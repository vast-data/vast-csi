$namespace P

$const uint32_t MAX_ENVS_PER_CNODE = 4;
$const uint32_t MAX_CNODES_PER_SYSTEM = 1024;
$const uint32_t MAX_ENVS_PER_SYSTEM = MAX_CNODES_PER_SYSTEM * MAX_ENVS_PER_CNODE;

$const uint32_t MAX_DBOXES_PER_SYSTEM = 64;
$const uint32_t MAX_DNODES_PER_SYSTEM = MAX_DBOXES_PER_SYSTEM * 2;

$const uint32_t DNODE_NVRAM_COUNT = 2;
$const uint32_t MAX_DRIVES_PER_DBOX = 256;
$const uint32_t MAX_NVRAMS_PER_SYSTEM = MAX_DNODES_PER_SYSTEM * DNODE_NVRAM_COUNT;
$const uint32_t MAX_DRIVES_PER_SYSTEM = MAX_DBOXES_PER_SYSTEM * MAX_DRIVES_PER_DBOX;

$const uint32_t MAX_SILOS_PER_ENV = 32
$const uint32_t MAX_MODULES_PER_SILO = 16; // should be ModuleId::COUNT
$const uint32_t MAX_SILOS_PER_SYSTEM = MAX_ENVS_PER_SYSTEM * MAX_SILOS_PER_ENV;
