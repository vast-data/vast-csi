$import object.vproto

$namespace Control

$typedef uint8_t SiloId;

enum ModuleState : byte {
    ONLINE,
    OFFLINE
};

struct ModuleBaseProto {
    @0 silo_id SiloId;
    @1 state ModuleState;
};

struct EModuleProto {
    @0 base_proto ObjectBaseProto;
    @1 base_module_proto ModuleBaseProto;
};

struct PModuleProto {
    @0 base_proto ObjectBaseProto;
    @1 base_module_proto ModuleBaseProto;
};

struct IModuleProto {
    @0 base_proto ObjectBaseProto;
    @1 base_module_proto ModuleBaseProto;
};

struct BModuleProto {
    @0 base_proto ObjectBaseProto;
    @1 base_module_proto ModuleBaseProto;
};

struct TModuleProto {
    @0 base_proto ObjectBaseProto;
    @1 base_module_proto ModuleBaseProto;
};

struct CModuleProto {
    @0 base_proto ObjectBaseProto;
    @1 base_module_proto ModuleBaseProto;
};
