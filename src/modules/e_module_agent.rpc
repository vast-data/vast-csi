class: EModuleAgent
include: ["e_module.vproto.hpp", "plasma/vproto/empty.vproto.hpp"]
api_version: 1
namespaces: ["P"]
default_fiber_group: E
methods:
- method: connect
  op_id: 1
  arg: ConnectParams
  res: VProto::Empty
- method: disconnect
  op_id: 2
  arg: DisconnectParams
  res: VProto::Empty
- method: vmsg_ping
  op_id: 3
  arg: VProto::Empty
  res: VProto::Empty
