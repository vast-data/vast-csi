$namespace Control

$import control/imdb/cnode.vproto as cnode
$import control/imdb/env.vproto as env

struct SystemInitParams {
    @0 guid GUID;
};

enum SystemInitResultCode {
    SUCCESS
};

struct SystemInitResult {
    @0 code SystemInitResultCode;
};

struct SystemStatusParams {

};

$import control/imdb/system.vproto as system

struct SystemStatusResult {
    @0 system system.SystemProto;
};

$const size_t CNODE_MAX_DATA_ENVS = 2;
$const size_t SILO_MAX_MODULES = 16; // TODO: this should be ModuleId::COUNT in the future.

struct SiloConfig {
    @0 modules_enabled bool[SILO_MAX_MODULES];
    @1 affinity int8_t; // core index or -1 for no affinity
};

struct EnvConfig {
    @0 silo_configs SiloConfig[env.ENV_MAX_SILOS];
    @1 silo_count byte;
    @2 port uint16_t;
};

struct CNodeAddParams {
    @0 guid GUID;
    @1 addresses cnode.NodeAddress[2];
    @2 env_configs EnvConfig[CNODE_MAX_DATA_ENVS];
    @3 env_count byte;
};

enum CNodeAddResultCode {
    SUCCESS,
    NO_MEM,
    GUID_ALREADY_EXISTS,
    ADDRESS_ALREADY_EXISTS
};

struct CNodeAddResult {
    @0 code CNodeAddResultCode;
};

struct CNodeModifyParams {
    @0 guid GUID;
    @1 enabled bool;
};

enum CNodeModifyResultCode {
    SUCCESS,
    NOT_FOUND
};

struct CNodeModifyResult {
    @0 code CNodeModifyResultCode;
};

struct CNodeRemoveParams {
    @0 guid GUID;
};

enum CNodeRemoveResultCode {
    SUCCESS,
    NOT_FOUND,
    NOT_DISABLED
};

struct CNodeRemoveResult {
    @0 code CNodeRemoveResultCode;
};

struct CNodeGetParams {
    @0 guid GUID;
};

enum CNodeGetResultCode {
    SUCCESS,
    NOT_FOUND
};

struct CNodeGetResult {
    @0 code CNodeGetResultCode;
    @1 cnode cnode.CNodeProto;
};

struct DBoxAddParams {
    @0 guid GUID;
    @1 addresses cnode.NodeAddress[4];
    @2 env_configs EnvConfig[CNODE_MAX_DATA_ENVS];
    @3 env_count byte;
};

enum DBoxAddResultCode {
    SUCCESS,
    NO_MEM,
    GUID_ALREADY_EXISTS,
    ADDRESS_ALREADY_EXISTS
};

struct DBoxAddResult {
    @0 code DBoxAddResultCode;
};

struct DNodeModifyParams {
    @0 guid GUID;
    @1 enabled bool;
};

enum DNodeModifyResultCode {
    SUCCESS,
    NOT_FOUND
};

struct DNodeModifyResult {
    @0 code DNodeModifyResultCode;
};
