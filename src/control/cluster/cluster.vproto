$namespace Control

$import control/imdb/cnode.vproto as cnode
$import control/imdb/dbox.vproto as dbox
$import control/imdb/dnode.vproto as dnode
$import control/imdb/env.vproto as env

struct SystemActivateParams {
    @0 guid GUID;
    @1 shard_count uint32_t;
};

enum SystemActivateResultCode {
    SUCCESS
};

struct SystemActivateResult {
    @0 code SystemActivateResultCode;
};

struct SystemRedistParams {
    @0 guid GUID;
};

enum SystemRedistResultCode {
    SUCCESS
};

struct SystemRedistResult {
    @0 code SystemRedistResultCode;
};

struct SystemStatusParams {

};

$import control/imdb/system.vproto as system

struct SystemStatusResult {
    @0 system system.SystemProto;
};

$const size_t CNODE_MAX_DATA_ENVS = 2;
$const size_t DNODE_MAX_DATA_ENVS = 2;
$const size_t SILO_MAX_MODULES = 6; // TODO: this should be ModuleId::COUNT in the future.

struct SiloConfig {
    @0 modules_enabled bool[SILO_MAX_MODULES];
    @1 affinity int8_t; // core index or -1 for no affinity
};

struct EnvConfig {
    @0 silo_configs SiloConfig[env.ENV_MAX_SILOS];
    @1 silo_count byte;
    @2 port uint16_t;
};

struct CNodeAddParams {
    @0 guid GUID;
    @1 addresses cnode.NodeAddress[2];
    @2 env_configs EnvConfig[CNODE_MAX_DATA_ENVS];
    @3 env_count byte;
};

enum CNodeAddResultCode {
    SUCCESS,
    NO_MEM,
    GUID_ALREADY_EXISTS,
    ADDRESS_ALREADY_EXISTS
};

struct CNodeAddResult {
    @0 code CNodeAddResultCode;
};

struct CNodeModifyParams {
    @0 guid GUID;
    @1 enabled bool;
};

enum CNodeModifyResultCode {
    SUCCESS,
    NOT_FOUND
};

struct CNodeModifyResult {
    @0 code CNodeModifyResultCode;
};

struct CNodeRemoveParams {
    @0 guid GUID;
};

enum CNodeRemoveResultCode {
    SUCCESS,
    NOT_FOUND,
    NOT_DISABLED
};

struct CNodeRemoveResult {
    @0 code CNodeRemoveResultCode;
};

struct CNodeGetParams {
    @0 guid GUID;
};

enum CNodeGetResultCode {
    SUCCESS,
    NOT_FOUND
};

struct CNodeGetResult {
    @0 code CNodeGetResultCode;
    @1 cnode cnode.CNodeProto;
};

struct DNodeConfig {
    @0 guid GUID;
    @1 addresses cnode.NodeAddress[2];
    @2 env_configs EnvConfig[DNODE_MAX_DATA_ENVS];
    @3 env_count byte;
};

struct DBoxAddParams {
    @0 guid GUID;
    @1 dnodes_config DNodeConfig[dbox.DNODES_PER_DBOX];
};

enum DBoxAddResultCode {
    SUCCESS,
    NO_MEM,
    GUID_ALREADY_EXISTS,
    ADDRESS_ALREADY_EXISTS
};

struct DBoxAddResult {
    @0 code DBoxAddResultCode;
};

struct DBoxGetParams {
    @0 guid GUID;
};

enum DBoxGetResultCode {
    SUCCESS,
    NOT_FOUND
};

struct DBoxGetResult {
    @0 code DBoxGetResultCode;
    @1 dbox dbox.DBoxProto;
    @2 dnodes dnode.DNodeProto[dbox.DNODES_PER_DBOX];
};

struct DNodeModifyParams {
    @0 guid GUID;
    @1 enabled bool;
};

enum DNodeModifyResultCode {
    SUCCESS,
    NOT_FOUND
};

struct DNodeModifyResult {
    @0 code DNodeModifyResultCode;
};
