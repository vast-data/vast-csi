class: PModuleAgent
include: ["p_module.vproto.hpp", "plasma/vproto/empty.vproto.hpp"]
api_version: 1
namespaces: ["P"]
default_fiber_group: P
methods:
- method: set_local_env_id
  op_id: 1
  arg: SetLocalEnvIdParams
  res: VProto::Empty
- method: env_start
  op_id: 2
  arg: EnvStartParams
  res: EnvStartResult
- method: env_stop
  op_id: 3
  arg: EnvStopParams
  res: EnvStopResult
- method: run_leader
  op_id: 4
  arg: VProto::Empty
  res: EnvStartResult
- method: connect_device
  op_id: 5
  arg: ConnectDeviceParams
  res: ConnectDeviceResult
- method: disconnect_device
  op_id: 6
  arg: DisconnectDeviceParams
  res: DisconnectDeviceResult
- method: list_nvrams
  op_id: 7
  arg: VProto::Empty
  res: ListNVRAMsResult
