$import e_module.vproto
$import control/dev_agent/dev_agent.vproto as dev
$import control/imdb/node.vproto as node
$import plasma/vmsg/vmsg.vproto as VMsg
$import defs.vproto as defs


$namespace P

$const size_t MAX_CONFIG_SIZE = 3684;

struct SetLocalEnvIdParams {
    @0 env_id VMsg.EnvId;
    @1 connect_params ConnectParams;
};

struct EnvStartParams {
    @0 env_guid GUID;
    @1 config char[MAX_CONFIG_SIZE];
};

enum EnvStartResultCode : uint8_t {
    SUCCESS,
    GUID_ALREADY_EXISTS,
    MAX_ENVS_CREATED,
    WRITE_FAILED,
    FORK_FAILED
};

struct EnvStartResult {
    @0 code EnvStartResultCode;
};

struct EnvStopParams {
    @0 env_guid GUID;
};

enum EnvStopResultCode : uint8_t {
    SUCCESS,
    GUID_NOT_FOUND,
    KILL_FAILED
};

struct EnvStopResult {
    @0 code EnvStopResultCode;
};

struct ConnectDeviceParams {
    @0 guid GUID;
    @1 dnode_addresses node.NodeAddress[node.NODE_ADDRESS_COUNT];
};

struct ConnectDeviceResult {
    @0 path char[dev.DEVICE_MAX_PATH];
};

struct DisconnectDeviceParams {
    @0 guid GUID;
};

struct DisconnectDeviceResult {

};

struct NVRAMInfo {
    @0 size uint64_t;
    @1 version uint32_t;
    @2 path char[dev.DEVICE_MAX_PATH];
};

struct ListNVRAMsResult {
    @0 nvrams NVRAMInfo[defs.DNODE_NVRAM_COUNT];
};
