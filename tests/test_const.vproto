$typedef bool flag

$namespace CONST

$const size_t INITIAL_VALUE = 100;

enum Profession : byte {
    PAINTER = INITIAL_VALUE,
    FEMALE
};

$const flag DEFAULT_ACTIVE = true;
$const size_t NAME_SIZE = 128;
$const Profession DEFAULT_PROFESSION = Profession::PAINTER;

struct Person {
    @0 profession Profession = DEFAULT_PROFESSION;
    @1 active flag = DEFAULT_ACTIVE;
    @2 name char[NAME_SIZE];
};
