$import object.vproto
$import plasma/vmsg/vmsg.vproto as VMsg
$import defs.vproto as defs

$namespace Control



enum EnvState : byte {
    INIT,
    ACTIVE
};

struct Silo {
    @0 affinity int8_t;
};

struct EnvProto {
    @0 base_proto BaseObjectProto;
    @1 connected bool;
    @2 state EnvState;
    @3 id VMsg.EnvId;
    @4 port uint16_t;
    @5 silos Silo[defs.MAX_SILOS_PER_ENV];
    @6 silo_count byte;
};
