$import object.vproto
$import plasma/vmsg/vmsg.vproto as VMsg

$namespace Control

$const P::byte ENV_MAX_SILOS = 32

enum EnvState : byte {
    INIT,
    ACTIVE
};

struct Silo {
    @0 affinity int8_t;
};

struct EnvProto {
    @0 base_proto BaseObjectProto;
    @1 connected bool;
    @2 state EnvState;
    @3 id VMsg.EnvId;
    @4 port uint16_t;
    @5 silos Silo[ENV_MAX_SILOS];
    @6 silo_count byte;
};
