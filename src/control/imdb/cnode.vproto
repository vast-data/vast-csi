$import object.vproto
$import plasma/vmsg/vmsg.vproto as VMsg

$namespace Control

enum CNodeState : byte {
    ACTIVE,
    INACTIVE,
    FAILED
};

struct CNodeAddress {
    @0 host char[VMsg.HOST_LENGTH];
};

struct CNodeProto {
    @0 base_proto ObjectBaseProto;
    @1 addresses CNodeAddress[2];
    @2 version uint32_t;
    @3 enabled bool;
    @4 state CNodeState;
};
